<Dashboards>

  <Include file="components/sliding_dashboard_for_current_day/datasets.3dl" />

  <Slider interval="20">
    <Dashboard
      data="current_date_data"
      title="1. HIV Viral Load (HVL) - Overview of samples received and tested for the reporting week"
      subTitle="%week_name% (Data from %firstDay% to %lastDay%)"
      lastRefresh="Last updated on : %today%"
    >
      <Include file="components/sliding_dashboard_for_current_day/tabs/hvl_overview_of_samples_received_tested_authorised_and_reffered.3dl" />
    </Dashboard>

    <Dashboard
      data="current_date_data"
      title="2. HIV Viral Load (HVL) - Overview of samples received and referred for the reporting week"
      subTitle="%week_name% (Data from %firstDay% to %lastDay%)"
      lastRefresh="Last updated on : %today%"
    >
      <Include file="components/sliding_dashboard_for_current_day/tabs/eid_overview_of_samples_received_tested_authorised_and_reffered.3dl" />
    </Dashboard>

      <Dashboard
      data="current_date_data"
      title="3. HIV Viral Load (HVL) trends in samples received, tested, and results authorized for last 4 weeks"
      subTitle="Data From %first_day_of_the_last_four_weeks% to %lastDay%"
      lastRefresh="Last updated on : %today%"
    >
      <Include file="components/sliding_dashboard_for_week_ending_yesterday/tabs/hvl_trends_samples_received_tested_results_authorized_for_last_4_weeks.3dl" />
    </Dashboard>

    <Dashboard
      data="current_date_data"
      title="4. HIV Viral Load (HVL) Trends- Turn Around Time"
      subTitle="Data From %first_day_of_the_last_four_weeks% to %lastDay%"
      lastRefresh="Last updated on : %today%"
    >
      <Include file="components/sliding_dashboard_for_week_ending_yesterday/tabs/hvl_trends_TAT.3dl" />
    </Dashboard>

    <Dashboard
      data="current_date_data"
      title="5. HIV Viral Load (HVL) Trends- Laboratory Testing Point"
      subTitle="%week_name% (Data from %firstDay% to %lastDay%) | Data From %first_day_of_the_last_four_weeks% to %lastDay% for Trend Graphs"
      lastRefresh="Last updated on : %today%"
    >
      <Include file="components/sliding_dashboard_for_week_ending_yesterday/tabs/hvl_trends_laboratory_testing_point.3dl" />
    </Dashboard>

    <Dashboard
      data="current_date_data"
      title="6. EID - Overview of samples received and testing for the reporting week"
      subTitle="%week_name% (Data from %firstDay% to %lastDay%) | Data From %first_day_of_the_last_four_weeks% to %lastDay% for Trend Graphs"
      lastRefresh="Last updated on : %today%"
    >
      <Include file="components/sliding_dashboard_for_week_ending_yesterday/tabs/eid_overview_of_samples_received_and_tested_for_last_week.3dl" />
    </Dashboard>

    <Dashboard
      data="current_date_data"
      title="7. EID - Overview of samples received and referred for the reporting week"
      subTitle="%week_name% (Data from %firstDay% to %lastDay%)"
      lastRefresh="Last updated on : %today%"
    >
      <Include file="components/sliding_dashboard_for_week_ending_yesterday/tabs/eid_referral.3dl" />
    </Dashboard>

    <Dashboard
      data="current_date_data"
      title="8. Early Infant HIV Diagnosis (EID) Trends- Turn Around Time"
      subTitle="Data From %first_day_of_the_last_four_weeks% to %lastDay%"
      lastRefresh="Last updated on : %today%"
    >
      <Include file="components/sliding_dashboard_for_week_ending_yesterday/tabs/eid_trends_TAT.3dl" />
    </Dashboard>

    <Dashboard
      data="current_date_data"
      title="9. EID - Laboratory Testing Quality"
      subTitle="%week_name% (Data from %firstDay% to %lastDay%) | Data From %first_day_of_the_last_four_weeks% to %lastDay% for Trend Graphs"
      lastRefresh="Last updated on : %today%"
    >
      <Include file="components/sliding_dashboard_for_week_ending_yesterday/tabs/eid_laboratory_testing_quality.3dl" />
    </Dashboard>

    <Dashboard
      data="current_date_data"
      title="10. Equipment Downtime"
      subTitle="%week_name% (Data from %firstDay% to %lastDay%)"
      lastRefresh="Last updated on : %today%"
    >
      <Include file="components/sliding_dashboard_for_week_ending_yesterday/tabs/equipment_downtime.3dl" />
    </Dashboard>
  </Slider>
</Dashboards>