<Dashboards>

  <Include file="components/sliding_dashboard_for_current_day/datasets.3dl" />

  <Slider interval="20" pauseOnHover="true">
    <Dashboard
      data="current_date_data"
      title="1. HIV Viral Load (HVL) - Overview of samples Received, testing, Authorised and Reffered"
      subTitle="Date: %today%"
      lastRefresh="Last updated on : %lastUpdated%"
    >
      <Include file="components/sliding_dashboard_for_current_day/tabs/hvl_overview_of_samples_received_tested_authorised_and_reffered.3dl" />
    </Dashboard>

    <Dashboard
      data="current_date_data"
      title="2. EID - Overview of samples Received, testing, Authorised and Reffered"
      subTitle="Date: %today%"
      lastRefresh="Last updated on : %lastUpdated%"
    >
      <Include file="components/sliding_dashboard_for_current_day/tabs/eid_overview_of_samples_received_tested_authorised_and_reffered.3dl" />
    </Dashboard>
  </Slider>
</Dashboards>