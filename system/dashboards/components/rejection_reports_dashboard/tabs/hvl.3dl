<Grid>
  <PrefilteredDashboard filters="start_date%d, end_date%d">
    <Row columns="1">
      <BarChart
        data="hvl_rejection_report_data"
        exportData="true"
        downloadVisual="true"
        expand="true"
        detailsComponent="infinite-scroll-table"
        header="HVL Rejection with reasons at Lab"
        subHeader=""
        headerSize="large"
        userOptions={{
                chart: { id: 2 },
                dataLabels: { enabled: true, style: { fontSize: "16px", fontWeight: 800 } },
                colors: ['#008000'],
                plotOptions: {
                    bar: {
                        distributed: false
                    }
                },
                tooltip: {
                shared: true,
                style: {
                fontSize: "16px",
                fontWeight: 700
                      }
                },
                legend: {
                show: true,
                position: "bottom",
                fontSize: '16px',
                fontWeight: 700
                },
                yaxis: { title: { text: "Number of Samples", style: { fontSize: "16px", fontWeight: 700 } } },
                xaxis: { title: { text: "Rejection Reasons", style: { fontSize: "16px", fontWeight: 700 } } }
            }}
        />
    </Row>
    <Row columns="1">
     <Table
            data="hvl_rejection_detailed_report"
            header="HVL SAMPLE REJECTION DETAILED"
            subHeader=""
            expand="true"
            exportData="true"
            showEntries="true"
          />
    </Row>
  </PrefilteredDashboard>
</Grid>;
