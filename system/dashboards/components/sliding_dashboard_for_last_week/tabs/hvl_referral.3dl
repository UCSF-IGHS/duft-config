<Grid>
    <Row columns="1">
        <BarChart
            data="hvl_samples_referred"
            exportData="true"
            downloadVisual="true"
            expand="true"
            detailsComponent="infinite-scroll-table"
            header="HVL Referral"
            subHeader=""
            headerSize="large"
            userOptions={{
                chart: { id: 1 },
                dataLabels: { enabled: true, style: { fontSize: "16px", fontWeight: 700 } },
                colors: ['#008000'],
                plotOptions: {
                    bar: {
                        distributed: false
                    }
                },
                yaxis: { title: { text: "Number of Samples", style: { fontSize: "16px", fontWeight: 600 } } },
                xaxis: { title: { style: { fontSize: "16px", fontWeight: 600 } } }
            }}
        />
    </Row>

    <Row columns="1">
        <ClusteredBarChart
            data="hvl_samples_referred_rejected_and_results_out_by_facility"
            header="Number of Samples Referred and Their Corresponding Receiving Laboratories"
            subHeader=""
            exportData="true"
            downloadVisual="true"
            expand="true"
            detailsComponent="infinite-scroll-table"
            headerSize="large"
            userOptions={{
                chart: { id: 40 },
                dataLabels: { enabled: true, style: { fontSize: "16px", fontWeight: 700 } },
                legend: { show: true, position: "bottom", fontSize: '16px', fontWeight: 700 },
                yaxis: { title: { text: "Number of Samples", style: { fontSize: "16px", fontWeight: 600 } } },
                xaxis: { title: { text: "Receiving Laboratories", style: { fontSize: "16px", fontWeight: 600 } } },
                tooltip: { shared: true, style: { fontSize: '16px' } },
                stroke: { width: 2 },
                colors: ["#008000", "#FF0000", "#FFA500"]
            }}
        />
    </Row>
</Grid>