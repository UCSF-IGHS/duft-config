<Grid>
    <Row columns="2">
        <ClusteredLineChart
            data="hvl_trend_of_samples_received_by_sample_type"
            header="HVL: Trend of Samples Received, by Sample Type"
            subHeader=""
            exportData="true"
            downloadVisual="true"
            expand="true"
            detailsComponent="infinite-scroll-table"
            headerSize="large"
            userOptions={{
                chart: { id: 5 },
                colors: ["#FFA500", "#008000"],
                dataLabels: {
                    enabled: true, background: { enabled: true, foreColor: "#000" }, 
                    style: { colors: ["#fff"], fontSize: "16px", fontWeight: 700 },
                    offsetY: -10
                },
                legend: { show: true, position: "bottom", fontSize: "16px", fontWeight: 700 },
                yaxis: { title: { text: "Number of Samples", style: { fontSize: "16px", fontWeight: 600 } } },
                xaxis: { title: { text: "Weeks", style: { fontSize: "16px", fontWeight: 600 } } },
                markers: { size: 5, hover: { size: 7 } }
            }}
        />

