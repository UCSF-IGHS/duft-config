<Datasets>

    {/* Data definitions for PMTCT_EID Weekly Performance */}

    <SQLData
        name="pmtct_eid_diagnosis_outcome_data"
        queryName="pmtct_eid/table/diagnosis_outcome"
        filterFrom="Week End Date"
        pageSize="15"
        sortColumn="Mother Patient ID"
    />

    <SQLData
        name="pmtct_eid_diagnosis_outcome_details_data"
        detailsViewData="pmtct_eid_diagnosis_outcome_data"
        detailsViewColumn="Mother Patient ID"
        transpose="true"
    >
      SELECT TOP 1
          [Mother Patient ID],
          [Exposed Infant ID],
          [Date of Birth],
          [HEI Age in Months],
          [Sex],
          [Week End Date],
          [Last Visit Date],
          [First Test Date],
          [First Test Results],
          [HEI Registered at Birth],
          [4 to 6 Weeks HEI Eligible for DNA PCR Test],
          [9 Months HEI Eligible for DNA PCR / Antibody Test],
          [3 Months Post BF HEI Eligible for Antibody Test],
          [18 Months HEI Eligible for Antibody Test],
          [HEI Eligible and Attended],
          [HEI Attended and Sample Taken],
          [HEI with No Documented DNA PCR Test]
      FROM
          duft.fact_duft_hei_sentinel_event
      WHERE
          [Patient ID] = '[[Mother Patient ID]]'
      ORDER BY
          [Last Visit Date] DESC;
    </SQLData>

</Datasets>
