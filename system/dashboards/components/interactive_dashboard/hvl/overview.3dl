                                style: {
                                    fontSize: "16px",
                                    fontWeight: 700,
                                    fontColor: "#fff"
                                },
                                offsetX: 10
                            }
                        },
                        yaxis: {
                            title: {
                                text: "Number of Samples",
                                style: {
                                    fontSize: "16px", 
                                    fontWeight: 600
                                }
                            },
                            labels: {
                                style: {
                                    fontSize: "16px", 
                                    fontWeight: 400
                                }
                            }
                        },
                        xaxis: {
                            title: {
                                text: "Week Number",
                                style: {
                                    fontSize: "16px",
                                    fontWeight: 600
                                }
                            },
                            labels: {
                                style: {
                                    fontSize: "16px",
                                    fontWeight: 400
                                }
                            }
                        }
                    }
                }
            />
