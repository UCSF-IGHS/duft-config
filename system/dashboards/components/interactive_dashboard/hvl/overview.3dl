<Grid>
    <PrefilteredDashboard filters="weekly_start_monday_period">
        <Row>
            <Header small="true">HVL Report Transformation Table</Header>
        </Row>

        <Row columns="1">
            <Table
                data="hvl_report_transformation_table_data"
                header="HVL Report Transformation Table"
                subheader=""
                exportData="true"
                expand="true"
                variant="plain"
                headerSize="large"
            />
        </Row>

        <Row>
            <Header small="true">HVL Weekly Reports</Header>
        </Row>

        <Row columns="2">
            <StackedBarChart
                data="vl_suppressed_and_unsuppressed_results_on_weekly_basis_data"
                header="Viral Load Suppression & Unsuppression Result on Weekly Basis"
                subheader=""
                exportData="true"
                detailsComponent="infinite-scroll-table"
                expand="true"
                headerSize="large"
                userOptions={
                    {
                        chart: { id: 31 },
                        tooltip: { 
                            shared: true, 
                            style: { 
                                fontSize: "16px", 
                                fontWeight: 700 
                            } 
                        },
                        legend: { 
                            show: true, 
                            position: "bottom", 
                            fontSize: '16px', 
                            fontWeight: 700 
                        },
                        dataLabels: {
                            enabled: true,
                            style: {
                                    fontSize: "16px",
                                    fontWeight: 700,
                                    fontColor: "#fff"
                                },
                            total: {
                                enabled: true,
                                style: {
                                    fontSize: "16px",
                                    fontWeight: 700,
                                    fontColor: "#fff"
                                },
                                offsetX: 10
                            }
                        },
                        yaxis: {
                            title: {
                                text: "Number of Samples",
                                style: {
                                    fontSize: "16px", 
                                    fontWeight: 600
                                }
                            },
                            labels: {
                                style: {
                                    fontSize: "16px", 
                                    fontWeight: 400
                                }
                            }
                        },
                        xaxis: {
                            title: {
                                text: "Week Number",
                                style: {
                                    fontSize: "16px", 
                                    fontWeight: 600
                                }
                            },
                            labels: {
                                style: {
                                    fontSize: "16px",
                                    fontWeight: 400
                                }
                            }
                        },
                        colors: ["#00BFFF", "#FFA500"]
                    }
                }
            />

            <ClusteredBarChart
                data="hvl_TAT_sample_collection_to_lab_reception_data"
                header="For Samples received in the reporting week, number of days from the sample collection to lab reception"
                subHeader=""
                exportData="true"
                expand="true"
                detailsComponent="infinite-scroll-table"
                headerSize="large"
                userOptions={
                    {
                        chart: {
                            id: 32
                        },
