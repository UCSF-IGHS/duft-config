<Grid>
  <PrefilteredDashboard filters="start_date%d, end_date%d">
    <Row columns="2">
      <BarChart
        data="hpv_samples_received_tested_rejectes_result_and_authorized"
        exportData="true"
        downloadVisual="true"
        expand="true"
        detailsComponent="infinite-scroll-table"
        header="HPV - Number of samples received, tested, rejected and results authorized"
        subHeader=""
        userOptions={{
          chart: { id: 9 },
          tooltip: { shared: true },
          dataLabels: { enabled: true },
          yaxis: { title: { text: "Number of Samples" } },
          colors: ['#008000'],
          plotOptions: {
                    bar: {
                        distributed: false
                    }
                },
        }}
      />

      <BarChart
        data="hpv_sample_received_by_region"
        exportData="true"
        downloadVisual="true"
        expand="true"
        detailsComponent="infinite-scroll-table"
        header="HPV - Number of samples received by region"
        subHeader=""
        userOptions={{
          chart: { id: 10 },
          tooltip: { shared: true },
          dataLabels: { enabled: true },
          yaxis: { title: { text: "Number of Samples" } },
          xaxis: { title: { text: "Region" } },
          colors: ['#008000'],
          plotOptions: {
                    bar: {
                        distributed: false
                    }
                },
        }}
      />
    </Row>

    <Row columns="2">
      <PieChart
        data="hpv_reason_sample_rejected"
        header="HPV - Reasons for sample rejection"
        subHeader=""
        exportData="true"
        downloadVisual="true"
        expand="true"
        detailsComponent="infinite-scroll-table"
        userOptions={{
          chart: { id: 11},
          legend: { show: true, position: "bottom" },
          dataLabels: { enabled: true, dropShadow: { enabled: false } }
        }}
      />
      <PieChart
        data="hpv_sample_test_outcome"
        header="HPV - Samples Test Outcomes"
        subHeader=""
        exportData="true"
        downloadVisual="true"
        expand="true"
        detailsComponent="infinite-scroll-table"
        userOptions={{
          chart: { id: 12},
          legend: { show: true, position: "bottom" },
          dataLabels: { enabled: true, dropShadow: { enabled: false } }
        }}
      />
    </Row>
  </PrefilteredDashboard>
</Grid>;
