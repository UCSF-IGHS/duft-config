<Grid>
    <Row columns="2">
        <BarChart
            data='eid_samples_tested_rejected_authorised'
            header="EID - Number of samples received, tested, rejected and results authorized for the reporting week"
            subHeader=""
            exportData="true"
            expand="true"
            downloadVisual="true"
            headerSize="large"
            detailsComponent="infinite-scroll-table"
            userOptions={{
                chart: { id: 17 },
                dataLabels: { enabled: true, style: { fontSize: "16px", fontWeight: 700 } },
                colors: ['#008000'],
                plotOptions: {
                    bar: {
                        distributed: false
                    }
                },
                yaxis: { title: { text: "Number of Samples", style: { fontSize: "16px", fontWeight: 600 } } },
                xaxis: { title: { style: { fontSize: "16px", fontWeight: 600 } } }
            }}
        />

        <BarChart
            data="eid_samples_received_by_region"
            header="EID - Number of samples received in the reporting week, by region"
            subHeader=""
            exportData="true"
            downloadVisual="true"
            expand="true"
            headerSize="large"
            detailsComponent="infinite-scroll-table"
            userOptions={{
                chart: { id: 18 },
                dataLabels: { enabled: true, style: { fontSize: "16px", fontWeight: 700 } },
                yaxis: { title: { text: "Number of Samples", style: { fontSize: "16px", fontWeight: 600 } } },
                xaxis: { title: { text: "Region", style: { fontSize: "16px", fontWeight: 600 } } },
                colors: ['#008000'],
                plotOptions: {
                    bar: {
                        distributed: false
                    }
                }
            }}
        >
            <InfoTag>
                <Markdown header="Descriptions for UNKNOWN and Not set">
                    UNKNOWN - Facility with no HFR code
                    Not set - Facility with unspecified name
                </Markdown>
            </InfoTag>
        </BarChart>
    </Row>

    <Row columns="2">
        <ClusteredLineChart
            data="eid_trend_of_samples_received_by_entry_modality"
            header="EID - Trend of Samples Received by Entry Modality"
            subHeader=""
            detailsComponent="infinite-scroll-table"
            exportData="true"
            downloadVisual="true"
            expand="true"
            headerSize="large"
            userOptions={{
                chart: { id: 19 },
                dataLabels: { enabled: true, background: { enabled: true, foreColor: "#000" }, style: { colors: ["#fff"], fontSize: "16px", fontWeight: 700 }, offsetY: -10 },
                markers: { size: 5, hover: { size: 7 } },
                legend: { show: true, position: "bottom", fontSize: "16px", fontWeight: 700 },
                yaxis: { title: { text: "Number of Samples", style: { fontSize: "16px", fontWeight: 600 } } },
                xaxis: { title: { text: "Weeks", style: { fontSize: "16px", fontWeight: 600 } } },
                colors: ["#008000", "#FFA500"]
            }}
        />

        <ClusteredLineChart
            data="eid_trend_of_samples_received_tested_and_authorised"
            header="EID - Trend of Samples Received, Tested & Dispatched"
            subHeader=""
            exportData="true"
            downloadVisual="true"
            expand="true"
            headerSize="large"
            detailsComponent="infinite-scroll-table"
            userOptions={{
                chart: { id: 20 },
                dataLabels: { enabled: true, background: { enabled: true, foreColor: "#000" }, style: { colors: ["#fff"], fontSize: "16px", fontWeight: 700 }, offsetY: -10 },
                markers: { size: 5, hover: { size: 7 } },
                legend: { show: true, position: "bottom", fontSize: "16px", fontWeight: 700 },
                yaxis: { title: { text: "Number of Samples", style: { fontSize: "16px", fontWeight: 600 } } },
                xaxis: { title: { text: "Weeks", style: { fontSize: "16px", fontWeight: 600 } } },
                colors: ["#008000", "#FFA500", "#FF0000"]
            }}
        />
    </Row>
</Grid>