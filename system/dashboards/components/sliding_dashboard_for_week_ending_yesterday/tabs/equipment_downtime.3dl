<Grid>
    <Row columns="2">
        <Table
            data="equipment_downtime"
            header="Equipment DownTime"
            subHeader=""
            expand="true"
            exportData="true"
            headerSize="large"
        />

        <BarChart
            data="equipment_utilization"
            exportData="true"
            downloadVisual="true"
            expand="true"
            detailsComponent="infinite-scroll-table"
            header="Equipment utilization (Actual Sample Tested) within the Lab"
            subHeader=""
            headerSize="large"
            userOptions={{
                chart: { id: 29 },
                tooltip: { shared: true, style: { fontSize: "16px", fontWeight: 700 } },
                yaxis: { title: { text: "Number of Samples" } },
                dataLabels: { enabled: true, style: { fontSize: "16px", fontWeight: 700 } },
                legend: { show: true, position: "bottom", fontSize: "16px", fontWeight: 700 },
                xaxis: { title: { style: { fontSize: "16px", fontWeight: 600 } } },
                yaxis: { title: { style: { fontSize: "16px", fontWeight: 600 } } }
            }}
        />
    </Row>
</Grid>