<Grid>
    <Row columns="2">
        <BarChart
            data="hvl_samples_tested_rejected_authorised"
            header="HVL - Number of samples received, rejected, tested and results authorized for the reporting week"
            subHeader=""
            exportData="true"
            downloadVisual="true"
            expand="true"
            headerSize="large"
            detailsComponent="infinite-scroll-table"
            userOptions={{
                chart: { id: 1 },
                dataLabels: { enabled: true, style: { fontSize: "16px", fontWeight: 700 } },
                colors: ['#008000'],
                plotOptions: {
                    bar: {
                        distributed: false
                    }
                },
                yaxis: { title: { text: "Number of Samples", style: { fontSize: "16px", fontWeight: 600 } } },
                xaxis: { title: { style: { fontSize: "16px", fontWeight: 600 } } }

            }}
        />

        <PieChart
            data="hvl_samples_received_by_type"
            header="HVL - Samples Received in the reporting week, by type"
            subHeader=""
            exportData="true"
            downloadVisual="true"
            expand="true"
            headerSize="large"
            detailsComponent="infinite-scroll-table"
            userOptions={{
                chart: { id: 2 },
                colors: ["#156082", "#e97132"],
                legend: { show: true, position: "bottom", fontSize: "16px", fontWeight: 700 },
                dataLabels: { enabled: true, dropShadow: { enabled: false }, style: { fontSize: "16px", fontWeight: 700 } },
                xaxis: { title: { style: { fontSize: "16px", fontWeight: 600 } } },
                yaxis: { title: { style: { fontSize: "16px", fontWeight: 600 } } }
            }}
        />
    </Row>

    <Row columns="2">
        <PieChart
            data="hvl_reasons_for_sample_rejection"
            header="HVL - Reasons for sample rejection for the reporting week"
            subHeader=""
            exportData="true"
            downloadVisual="true"
            expand="true"
            headerSize="large"
            detailsComponent="infinite-scroll-table"
            userOptions={{
                chart: { id: 3 },
                legend: { show: true, position: "bottom", fontSize: "16px", fontWeight: 700 },
                dataLabels: { enabled: true, dropShadow: { enabled: false }, style: { fontSize: "16px", fontWeight: 700 } },
                xaxis: { title: { style: { fontSize: "16px", fontWeight: 600 } } },
                yaxis: { title: { style: { fontSize: "16px", fontWeight: 600 } } }
            }}
        />

        <BarChart
            data="hvl_samples_received_by_region"
            header="HVL - Number of samples received in the reporting week, by region"
            subHeader=""
            exportData="true"
            downloadVisual="true"
            expand="true"
            headerSize="large"
            detailsComponent="infinite-scroll-table"
            userOptions={{
                chart: { id: 4 },
                dataLabels: { enabled: true, style: { fontSize: "16px", fontWeight: 700 } },
                yaxis: { title: { text: 'Number of Samples', style: { fontSize: "16px", fontWeight: 600 } } },
                xaxis: { title: { text: 'Region', style: { fontSize: "16px", fontWeight: 600 } } },
                colors: ['#008000'],
                plotOptions: {
                    bar: {
                        distributed: false
                    }
                },
                legend: {
                    position: "top",
                    fontSize: "16px",
                    fontWeight: 700,
                    labels: { colors: "#333" },
                    itemMargin: { horizontal: 10, vertical: 5 },
                    markers: { width: 12, height: 12 }
                }
            }}
        >
            <InfoTag>
                <Markdown header="Descriptions for UNKNOWN and Not set">
                    UNKNOWN - Facility with no HFR code
                    Not set - Facility with unspecified name
                </Markdown>
            </InfoTag>
        </BarChart>
    </Row>
</Grid>