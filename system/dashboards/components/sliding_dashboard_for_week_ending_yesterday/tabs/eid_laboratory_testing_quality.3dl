<Grid>
    <Row columns="2" >
        <PieChart
            data="eid_test_outcomes"
            exportData="true"
            downloadVisual="true"
            detailsComponent="infinite-scroll-table"
            header="EID: Test outcomes for the reporting week"
            subHeader=""
            expand="true"
            headerSize="large"
            userOptions={{
                chart: { id: 25 },
                legend: { show: true, position: "right", fontSize: '16px', fontWeight: 700 },
                dataLabels: { enabled: true, dropShadow: { enabled: false }, style: { fontSize: "16px", fontWeight: 700 } },
                colors: ["#008000", "#FFFF00", "#FFA500"],
                yaxis: { title: { style: { fontSize: "16px", fontWeight: 600 } } },
                xaxis: { title: { style: { fontSize: "16px", fontWeight: 600 } } }
            }}
        />

        <LineChart
            data="eid_trend_of_invalid_test_results"
            exportData="true"
            downloadVisual="true"
            expand="true"
            detailsComponent="infinite-scroll-table"
            header="EID: Trend of invalid test results"
            subHeader=""
            headerSize="large"
            userOptions={{
                chart: { id: 26 },
                legend: { show: true, style: { fontSize: "16px", fontWeight: 700 } },
                dataLabels: { enabled: true, background: { enabled: true, foreColor: "#000" }, style: { colors: ["#fff"], fontSize: "16px", fontWeight: 700 }, offsetY: -10 },
                markers: { size: 5, hover: { size: 7 } },
                yaxis: { title: { text: "% of Samples", style: { fontSize: "16px", fontWeight: 600 } } },
                xaxis: { title: { text: "Weeks", style: { fontSize: "16px", fontWeight: 600 } } },
                colors: ["#1e3799"]
            }}
        />
    </Row>

    <Row columns="2" >
        <LineChart
            data="eid_trend_of_rejected_samples"
            detailsComponent="infinite-scroll-table"
            header="EID: Trend of Sample Rejection Rate"
            subHeader=""
            exportData="true"
            downloadVisual="true"
            expand="true"
            headerSize="large"
            userOptions={{
                chart: { id: 27 },
                legend: { show: true, style: { fontSize: "16px", fontWeight: 700 } },
                dataLabels: { enabled: true, background: { enabled: true, foreColor: "#000" }, style: { colors: ["#fff"], fontSize: "16px", fontWeight: 700 }, offsetY: -10 },
                markers: { size: 5, hover: { size: 7 } },
                yaxis: { title: { text: "% of Samples", style: { fontSize: "16px", fontWeight: 600 } } },
                xaxis: { title: { text: "Weeks", style: { fontSize: "16px", fontWeight: 600 } } },
                colors: ["#1e3799"]
            }}
        />

        <ClusteredBarChart
            data="eid_sample_aging"
            header="EID: Sample age for samples still in the lab at the end of reporting week"
            detailsComponent="infinite-scroll-table"
            subHeader=""
            exportData="true"
            expand="true"
            downloadVisual="true"
            headerSize="large"
            userOptions={{
                chart: { id: 28 },
                dataLabels: { enabled: true, style: { fontSize: "16px", fontWeight: 700 } },
                plotOptions: { bar: { horizontal: true } },
                legend: { show: true, position: "bottom", fontSize: "16px", fontWeight: 700 },
                tooltip: { shared: true, style: { fontSize: "16px", fontWeight: 700 } },
                stroke: { width: 2 },
                xaxis: { title: { style: { fontSize: "16px", fontWeight: 600 } } },
                yaxis: { title: { style: { fontSize: "16px", fontWeight: 600 } } }
            }}
        />
    </Row>
</Grid>