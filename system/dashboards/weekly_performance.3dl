<Dashboards>

    <Include file="components/common/datasets.3dl" />

    <Include file="components/pmtct_eid/datasets.3dl" />

    <SQLData name="dateBounds">
        SELECT
            (SELECT MIN(date)
             FROM derived.dim_date) AS min_date,

            (SELECT MAX(date)
             FROM derived.dim_date) AS max_date,

            (SELECT DATEADD(DAY, -7, weekly_start_monday_start_date)
             FROM derived.dim_date
             WHERE date = DATEADD(DAY, -1, CAST(GETDATE() AS DATE))
            ) AS default_start,

            DATEADD(DAY, -1, CAST(GETDATE() AS DATE)) AS default_end
    </SQLData>

    <Dashboard
        data="pmtct_eid_metadata"
        tabName="A. Diagnosis & Outcome"
        title="Facility: %hfr_code%"
        lastRefresh="Reporting Weeks: %date_range%"
    >

        <Filters>
            <DateRangePicker type="date" name="Week End Date" allowFutureDates="false">
                <DefaultRangeStartDate dataSource="dateBounds" dataColumn="default_start" />
                <DefaultRangeEndDate dataSource="dateBounds" dataColumn="default_end" />
                <MinSelectableDate dataSource="dateBounds" dataColumn="min_date" />
                <MaxSelectableDate dataSource="dateBounds" dataColumn="max_date" />
            </DateRangePicker>
        </Filters>

        <SingleLayout>
            <Grid>
                <Header>
                    PMTCT/EID Diagnosis and Outcome Tracking
                </Header>
                <SubHeader>
                    PMTCT/EID diagnosis and outcome tracking for the reporting week.
                </SubHeader>
                <Table
                    data="pmtct_eid_diagnosis_outcome_data"
                    exportData="true"
                    header="Diagnosis & Outcome"
                    subHeader="Table of PMTCT/EID clients tracked for weekly diagnosis and outcome reporting."
                    variant="plain"
                    initialColumns="Mother Patient ID, Exposed Infant ID, HEI Age in Months, Week End Date, 4 to 6 Weeks HEI Eligible for DNA PCR Test, 9 Months HEI Eligible for DNA PCR Test, 3 Months Post BF HEI Eligible for Antibody Test, 18 Months HEI Eligible for Antibody Test, HEI Eligible and Attended, HEI Attended and Sample Taken, HEI with Undocumented DNA PCR Test"
                    detailsViewColumn="Mother Patient ID"
                >
                    <Table data="pmtct_eid_diagnosis_outcome_details_data" header="PMTCT/EID Details" />
                </Table>
            </Grid>
        </SingleLayout>
    </Dashboard>

</Dashboards>