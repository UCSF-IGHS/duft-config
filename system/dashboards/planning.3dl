<Dashboards>

    <Include file="components/common/datasets.3dl" />

    <Include file="components/planning/datasets.3dl" />

    <Dashboard
        data="metadata"
        tabName="A. Overview"
        title="Facility: %hfr_code%"
        lastRefresh="Reporting Period: %date_range%"
    >

        <Filters>
            <DateRangePicker type="date" name="Next Appointment Date" allowFutureDates="false" >

                <DefaultRangeStartDate>{() => dayjs().add(1, 'week').startOf('week').add(1, 'day')}</DefaultRangeStartDate>

                <DefaultRangeEndDate>{() => dayjs().add(1, 'week').startOf('week').add(7, 'day')}</DefaultRangeEndDate>

                <MinSelectableDate>{() => dayjs().subtract(1, 'day')}</MinSelectableDate>

                <MaxSelectableDate>{() => dayjs().add(1, 'week').startOf('week').add(7, 'day')}</MaxSelectableDate>

            </DateRangePicker>
        </Filters>

        <Include file="components/planning/overview.3dl" />
    </Dashboard>

    <Dashboard
        data="metadata"
        tabName="B. Eligible Up to Next Week"
        title="Facility: %hfr_code%"
        lastRefresh="Reporting Period: %date_range%"
    >

        <Filters>
            <DateRangePicker type="date" name="Next Appointment Date" allowFutureDates="false" >

                <DefaultRangeStartDate>{() => dayjs().add(1, 'week').startOf('week').add(1, 'day')}</DefaultRangeStartDate>

                <DefaultRangeEndDate>{() => dayjs().add(1, 'week').startOf('week').add(7, 'day')}</DefaultRangeEndDate>

                <MinSelectableDate>{() => dayjs().subtract(1, 'day')}</MinSelectableDate>

                <MaxSelectableDate>{() => dayjs().add(1, 'week').startOf('week').add(7, 'day')}</MaxSelectableDate>

            </DateRangePicker>

            <Filter caption="Eligibility Area" name="Eligibility Area" data="eligibility_area_data" />
        </Filters>

        <SingleLayout>
            <Grid>
                <Header>
                    Clients With Appointments Up to Next Week
                </Header>
                <SubHeader>
                    Table of clients who have appointments from today up to Next Week.
                </SubHeader>
                <Table
                    data="plhiv_next_week_clients_data"
                    header="Clients With Appointments Up to Next Week"
                    subHeader="Table of clients who have appointments from today up to Next Week."
                    exportData="true"
                    variant="plain"
                    initialColumns="Patient ID, Current Age, Sex, Date Start ART, Last Visit Date, Next Appointment Date, VL Eligible Date, Eligible for HVL Up to Next Week, Eligible for EAC Up to Next Week, Eligible for CD4 Up to Next Week, Eligible for CrAg Up to Next Week, Eligible for CPeT Up to Next Week, Eligible for CMT Up to Next Week"
                    detailsViewColumn="Patient ID"
                >
                <Table data="plhiv_next_week_client_details_data" variant="plain" header="Client Profile" />
                </Table>
            </Grid>
        </SingleLayout>
    </Dashboard>

</Dashboards>