<Dashboards>

    <Include file="components/sample_tracking_reports_dashboard/datasets.3dl" />

    <Dashboard
        data="hvl_sample_tracking_report_data"
        tabName="HVL Tracking Report"
        title=""
        subTitle="HVL Tracking Report"
        lastRefresh=""
    >
        <Filters>
            <DatePicker type="date" name="start_date" />
            <DatePicker type="date" name="end_date" />
        </Filters>

        <Grid>
            <PrefilteredDashboard filters="start_date%d, end_date%d">
                <Row columns="1">
                    <Table
                        data="hvl_sample_tracking_report_data"
                        header="Sample Tracking Report for HVL Test Name"
                        subHeader=""
                        exportData="true"
                        expand="true"
                        showEntries="true"
                        headerSize="large"
                    />
                </Row>
            </PrefilteredDashboard>
        </Grid>
    </Dashboard>

    <Dashboard
        data="eid_sample_tracking_report_data"
        tabName="EID Tracking Report"
        title=""
        subTitle="EID Tracking Report"
        lastRefresh=""
    >
        <Filters>
            <DatePicker type="date" name="start_date" />
            <DatePicker type="date" name="end_date" />
        </Filters>

        <Grid>
            <PrefilteredDashboard filters="start_date%d, end_date%d">
                <Row columns="1">
                    <Table
                        data="eid_sample_tracking_report_data"
                        header="Sample Tracking Report for EID Test Name"
                        subHeader=""
                        exportData="true"
                        expand="true"
                        showEntries="true"
                        headerSize="large"
                    />
                </Row>
            </PrefilteredDashboard>
        </Grid>
    </Dashboard>
</Dashboards>